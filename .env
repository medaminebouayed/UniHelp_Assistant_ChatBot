# ────────────────────────────────────────────────────
# Shared environment variables for Docker Compose
# Copy this file as .env and adjust values if needed
# ────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password1234
POSTGRES_DB=graphrag
PG_HOST=postgres
PG_PORT=5432
DATABASE_URL=postgresql://postgres:password1234@postgres:5432/graphrag

# Neo4j
NEO4J_AUTH=neo4j/password123
NEO4J_PASSWORD=password123
NEO4J_URI=bolt://neo4j:7687

# Groq (Cloud LLM) — leave empty to use Ollama instead
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# Backend
SECRET_KEY=changez-moi-en-production
ADMIN_EMAIL=admin@unihelp.tn
ADMIN_PASSWORD=admin123

# Public API URL (used for downloadable source links in RAG chunks)
PUBLIC_API_URL=http://localhost:8000

# RAG API
RAG_API_URL=http://rag-api:8002
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
RAG_API_PORT=8002
HF_TOKEN=

# SMTP — set these for email functionality
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=UniHelp
